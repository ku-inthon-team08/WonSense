# Supabase 대시보드 > Project Settings > API 에서 확인
SUPABASE_URL=https://<project-ref>.supabase.co
# 백엔드 전용 키. 절대 프론트엔드나 깃에 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 서울 열린데이터광장 인증키 (생필품 농수축산물 가격 정보)
SEOUL_OPENAPI_KEY=

# Claude API 키 (바가지 판독기). 백엔드 전용, 절대 프론트엔드나 깃에 노출하지 말 것
ANTHROPIC_API_KEY=

# Claude 대신 Lablup Token Factory(Anthropic 호환)로 바꾸려면 셋 다 채운다. 비우면 위 Claude API를 쓴다
# 키 발급: https://console.lablup.ai > 내 API 키. 연결 점검: python -m scripts.check_llm [사진.jpg]
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 예)
# LLM_BASE_URL=https://api.console.lablup.ai/anthropic
# LLM_MODEL=DeepSeek-V4.1-Flash-B300  (콘솔 연결 메뉴에서 "사용 가능"인 모델)

# 공공데이터포털 일반 인증키 (Decoding 키). 한국소비자원 참가격 생필품 가격 수집용 (로컬 수집 스크립트에서만 사용)
DATA_GO_KR_API_KEY=

# 카카오 디벨로퍼스 REST API 키 (JavaScript 키 아님). 식당 가격 수집 스크립트용 (로컬에서만 사용)
KAKAO_REST_API_KEY=

# 프론트엔드 주소 (쉼표로 여러 개). 배포 주소를 직접 넣어도 된다
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# 정규식으로 허용할 주소. 기본값은 Vercel 프로덕션·프리뷰(won-sense*.vercel.app). 비우면 끔
# CORS_ORIGIN_REGEX=https://won-sense(-[a-z0-9-]+)?\.vercel\.app
