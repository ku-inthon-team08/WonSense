# Copy to .env.local. The browser only talks to the FastAPI backend (RLS blocks direct DB access).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production (Vercel): set NEXT_PUBLIC_API_URL to the deployed backend's https URL in
# Project Settings > Environment Variables, then redeploy (it is inlined at build time).

# Kakao JavaScript key for the store search in the review form. Register each site domain on the Kakao app.
# Also set it in Vercel, then redeploy. Without it, the form still works with manual entry.
NEXT_PUBLIC_KAKAO_JS_KEY=
